{
  "configVersion": 1,
  "graphRef": "./dom-rule-sampling.graph.json",
  "configs": {
    "cardMatchRule": {
      "ruleId": "synthetic.dom.semantic-rules.v1",
      "rules": [
        {
          "semanticLabel": "post.card",
          "match": [
            {
          "tag": "article",
          "classIncludes": [
            "synthetic-feed-card"
          ]
            }
          ]
        },
        {
          "semanticLabel": "post.body",
          "match": [
            {
              "tag": "div",
              "classIncludes": [
                "synthetic-post-body"
              ]
            }
          ]
        },
        {
          "semanticLabel": "post.content",
          "match": [
            {
              "tag": "div",
              "classIncludes": [
                "synthetic-post-content"
              ]
            }
          ]
        },
        {
          "semanticLabel": "editor.composer",
          "match": [
            {
              "tag": "div",
              "classIncludes": [
                "synthetic-editor-composer"
              ]
            }
          ]
        },
        {
          "semanticLabel": "feed.toolbar",
          "match": [
            {
              "tag": "div",
              "classIncludes": [
                "synthetic-feed-toolbar"
              ]
            }
          ]
        }
      ]
    },
    "cardSampleSpec": {
      "taskId": "synthetic.post.card.structure",
      "supervisionMap": {
        "post.card": "positive",
        "post.body": "negative",
        "post.content": "negative",
        "editor.composer": "negative"
      },
      "expectedLabels": {
        "positive": "post.card",
        "negative": "not.post.card"
      },
      "unmappedPolicy": "unlabeled"
    },
    "localSaveSpec": {
      "fileName": "synthetic-card.samples.jsonl",
      "writeMode": "create_new"
    }
  },
  "bindings": {
    "按显式规则匹配DOM记录": {
      "configRef": "cardMatchRule"
    },
    "组装单任务训练样本": {
      "configRef": "cardSampleSpec"
    },
    "保存样本到本地目录": {
      "configRef": "localSaveSpec"
    }
  }
}
