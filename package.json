  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/check-layout.mjs && tsc -p tsconfig.json && node scripts/build-kotlin-symbol-jvm.mjs && node scripts/build-java-symbol-jvm.mjs",
    "build:kotlin-symbol-jvm": "node scripts/build-kotlin-symbol-jvm.mjs",
    "build:java-symbol-jvm": "node scripts/build-java-symbol-jvm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:full": "npm run build && node scripts/test-full.mjs",
    "test:cli-command-search": "node --test tests/cli-command-search.test.mjs",
    "demo": "npm run build && node playground/common/demo.mjs",
    "demo:browser": "npm run build && node playground/browser/demo.mjs",
    "demo:sampling": "npm run build && node playground/sampling/demo.mjs",
    "demo:basic-kinds": "npm run build && node playground/basic-kinds/demo.mjs",
    "demo:training": "npm run build && node playground/training/demo.mjs",
    "demo:cli": "npm run build && node playground/cli/foundation.mjs",
    "prepare:path-samples": "npm run build && node playground/cli/path-resolve/prepare.mjs",
    "demo:path-training": "npm run build && node playground/cli/path-resolve/train.mjs",
    "demo:command-training": "npm run build && node playground/cli/command-learning/train.mjs",
    "prepare:tsjs-retention-contrast": "npm run build && node scripts/materialize-tsjs-retention-contrast.mjs",
    "validate:tsjs-retention-contrast": "npm run build && node scripts/validate-tsjs-retention-contrast.mjs",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "typecheck:ui": "tsc -p playground/overlay/tsconfig.json --noEmit",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "flowed": "1.15.0",
    "tree-sitter": "0.22.4",
    "tree-sitter-rust": "0.24.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  }
}
